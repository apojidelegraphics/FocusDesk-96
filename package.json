{
  "name": "focusdesk-96",
  "productName": "FocusDesk 96",
  "version": "1.2.2",
  "description": "FocusDesk 96 — a Windows 95-style study and productivity desktop, as a native app for macOS, Windows and Linux.",
  "main": "main.js",
  "author": {
    "name": "Apoji Delegraphics",
    "email": "noreply@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/apojidelegraphics/FocusDesk-96",
  "repository": "apojidelegraphics/FocusDesk-96",
  "bugs": {
    "url": "https://github.com/apojidelegraphics/FocusDesk-96/issues"
  },
  "keywords": [
    "study",
    "productivity",
    "focus",
    "windows95",
    "electron"
  ],
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/build-icon.js && node scripts/vendor-katex.js",
    "build": "electron-builder",
    "prebuild:mac": "node scripts/build-icon.js && node scripts/vendor-katex.js",
    "build:mac": "electron-builder --mac dmg",
    "prebuild:win": "node scripts/build-icon.js && node scripts/vendor-katex.js",
    "build:win": "electron-builder --win nsis",
    "prebuild:linux": "node scripts/build-icon.js && node scripts/vendor-katex.js",
    "build:linux": "electron-builder --linux AppImage",
    "postinstall": "node scripts/vendor-katex.js"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "katex": "^0.19.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.apojistudios.focusdesk96",
    "productName": "FocusDesk 96",
    "copyright": "Copyright © 2026 Apoji Delegraphics and Apoji Studios",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "timer-mini.html",
      "aux-preload.js",
      "nowplaying.html",
      "nowplaying.js",
      "assets/**",
      "capture-preload.js",
      "capture.html",
      "index.html",
      "focusdesk.js",
      "focusdesk-desk.js",
      "focusdesk.css",
      "apojilogo.js",
      "package.json",
      "vendor/**"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "FocusDesk-96-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "FocusDesk 96 reads the current song and sends play, pause and skip to Spotify or Music for its Now Playing pill."
      }
    },
    "dmg": {
      "title": "FocusDesk 96 ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "FocusDesk-96-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "maintainer": "Apoji Delegraphics <noreply@users.noreply.github.com>",
      "artifactName": "FocusDesk-96-${version}.${ext}"
    }
  }
}
